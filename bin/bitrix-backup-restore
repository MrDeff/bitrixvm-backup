#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/logging.sh"
source "$ROOT_DIR/lib/config.sh"
source "$ROOT_DIR/lib/restic.sh"

usage() {
  cat <<'USAGE'
Usage: bitrix-backup-restore --config /etc/bitrix-backup/sites.yml --site SITE [--kind files|db|both] [--target /restore] [--snapshot latest] [--files-snapshot ID] [--db-snapshot ID]
USAGE
}

config=""
site=""
kind="both"
target="/restore"
snapshot="latest"
files_snapshot=""
db_snapshot=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --config)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        log_error "--config requires a path"
        usage
        exit 2
      fi
      config="$2"
      shift 2
      ;;
    --site)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        log_error "--site requires a code"
        usage
        exit 2
      fi
      site="$2"
      shift 2
      ;;
    --kind)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        log_error "--kind requires files, db, or both"
        usage
        exit 2
      fi
      kind="$2"
      shift 2
      ;;
    --target)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        log_error "--target requires a path"
        usage
        exit 2
      fi
      target="$2"
      shift 2
      ;;
    --snapshot)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        log_error "--snapshot requires a snapshot id"
        usage
        exit 2
      fi
      snapshot="$2"
      shift 2
      ;;
    --files-snapshot)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        log_error "--files-snapshot requires a snapshot id"
        usage
        exit 2
      fi
      files_snapshot="$2"
      shift 2
      ;;
    --db-snapshot)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        log_error "--db-snapshot requires a snapshot id"
        usage
        exit 2
      fi
      db_snapshot="$2"
      shift 2
      ;;
    *)
      log_error "Unknown argument: $1"
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$config" ]]; then
  log_error "--config is required"
  usage
  exit 2
fi

if [[ -z "$site" ]]; then
  log_error "--site is required"
  usage
  exit 2
fi

case "$kind" in
  files|db|both)
    ;;
  *)
    log_error "invalid --kind: $kind"
    usage
    exit 2
    ;;
esac

source_env_file() {
  local env_file="$1"
  local status

  set -a
  # shellcheck disable=SC1090
  source "$env_file"
  status=$?
  set +a
  return "$status"
}

restore_id() {
  local snapshot_value="$1"
  if [[ "$snapshot_value" == "latest" ]]; then
    date -u '+%Y%m%dT%H%M%SZ'
  else
    printf '%s\n' "$snapshot_value" | sed -E 's/[^A-Za-z0-9_.-]+/-/g; s/^-+//; s/-+$//'
  fi
}

ensure_empty_dir() {
  local output="$1"
  mkdir -p "$output"
  if find "$output" -mindepth 1 -print -quit | grep . >/dev/null; then
    log_error "restore output is not empty: $output"
    return 1
  fi
}

restic_with_env() {
  local env_file="$1"
  shift
  (
    source_env_file "$env_file"
    restic_base "$@"
  )
}

restore_files() {
  local repo="$1"
  local env_file="$2"
  local snapshot_value="$3"
  local output="$4"

  ensure_empty_dir "$output"
  restic_with_env "$env_file" "$repo" restore "$snapshot_value" --tag kind:files --target "$output"
}

restore_db() {
  local repo="$1"
  local env_file="$2"
  local snapshot_value="$3"
  local output="$4"
  local snapshot_id db_path tmp_file

  ensure_empty_dir "$(dirname "$output")"
  snapshot_id="$snapshot_value"
  if [[ "$snapshot_id" == "latest" ]]; then
    snapshot_id="$(restic_with_env "$env_file" "$repo" snapshots --json --tag kind:db | python3 -c 'import json,sys
data=json.load(sys.stdin)
if not data:
    sys.exit(1)
snap=max(data, key=lambda item: item.get("time", ""))
print(snap.get("id") or snap.get("short_id") or "")
')"
  fi
  [[ -n "$snapshot_id" ]] || {
    log_error "cannot resolve DB snapshot"
    return 1
  }
  db_path="$(restic_with_env "$env_file" "$repo" ls --json "$snapshot_id" | python3 -c 'import json,sys
for line in sys.stdin:
    item=json.loads(line)
    if item.get("type") == "file" and item.get("path", "").endswith("/db.sql"):
        print(item["path"])
        sys.exit(0)
sys.exit(1)
')"
  [[ -n "$db_path" ]] || {
    log_error "cannot find db.sql in DB snapshot"
    return 1
  }
  tmp_file="$(mktemp "$(dirname "$output")/db.sql.XXXXXX")"
  if restic_with_env "$env_file" "$repo" dump "$snapshot_id" "$db_path" >"$tmp_file"; then
    chmod 600 "$tmp_file"
    mv "$tmp_file" "$output"
  else
    local status=$?
    rm -f "$tmp_file"
    return "$status"
  fi
}

restore_site="$site"
restore_kind="$kind"
restore_target="$target"
restore_snapshot="$snapshot"
restore_files_snapshot="${files_snapshot:-$restore_snapshot}"
restore_db_snapshot="${db_snapshot:-$restore_snapshot}"
restore_repo="$(config_site_field "$config" "$restore_site" repo)" || exit 1
restore_env_file="$(config_site_field "$config" "$restore_site" env_file)" || exit 1
if [[ "$restore_files_snapshot" == "$restore_db_snapshot" ]]; then
  restore_id_value="$(restore_id "$restore_files_snapshot")"
else
  restore_id_value="$(restore_id "$restore_files_snapshot")_$(restore_id "$restore_db_snapshot")"
fi
restore_root="$restore_target/$restore_site/$restore_id_value"

case "$restore_kind" in
  files)
    restore_files "$restore_repo" "$restore_env_file" "$restore_files_snapshot" "$restore_root/files"
    ;;
  db)
    restore_db "$restore_repo" "$restore_env_file" "$restore_db_snapshot" "$restore_root/db/db.sql"
    ;;
  both)
    restore_files "$restore_repo" "$restore_env_file" "$restore_files_snapshot" "$restore_root/files"
    restore_db "$restore_repo" "$restore_env_file" "$restore_db_snapshot" "$restore_root/db/db.sql"
    ;;
esac
